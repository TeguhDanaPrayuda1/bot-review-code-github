# ===== GitHub App =====
# App ID dari halaman pengaturan GitHub App
GITHUB_APP_ID=123456
# Private key: pilih SALAH SATU cara di bawah.
# 1) Isi PEM langsung (ganti newline dengan \n), atau
# 2) Path ke file .pem
GITHUB_PRIVATE_KEY=
GITHUB_PRIVATE_KEY_PATH=./github-app.private-key.pem
# Secret yang sama dengan yang diisi di form webhook GitHub App
GITHUB_WEBHOOK_SECRET=ganti-dengan-secret-acak
# Untuk GitHub Enterprise, ubah ke https://<host>/api/v3
GITHUB_API_URL=https://api.github.com

# ===== LLM =====
# Provider: anthropic | openai_compatible
#
# Contoh A — Anthropic langsung:
#   LLM_PROVIDER=anthropic
#   ANTHROPIC_API_KEY=sk-ant-...
#
# Contoh B — gateway pihak ketiga yang OpenAI-compatible
# (endpoint /v1/chat/completions, mis. openagentic.id / OpenRouter):
#   LLM_PROVIDER=openai_compatible
#   LLM_API_KEY=<api key dari gateway>
#   LLM_BASE_URL=https://api.gateway-anda.tld/v1
#   LLM_MODEL=<nama model sesuai daftar gateway>
#
# Contoh C — gateway yang Anthropic-compatible (endpoint /v1/messages):
#   LLM_PROVIDER=anthropic
#   ANTHROPIC_API_KEY=<api key dari gateway>
#   LLM_BASE_URL=https://api.gateway-anda.tld
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=claude-opus-5
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=3

# ===== Perilaku review =====
# Pola file/folder yang dilewati (glob, dipisah koma; akhiri "/" untuk folder)
SKIP_PATTERNS=*.lock,package-lock.json,yarn.lock,pnpm-lock.yaml,poetry.lock,dist/,build/,node_modules/,vendor/,*.min.js,*.min.css,*.map,*.svg,*.png,*.jpg,*.jpeg,*.gif,*.ico,*.pdf,*.snap
# Batas ukuran diff per file yang dikirim ke LLM (karakter); sisanya dipotong
MAX_FILE_DIFF_CHARS=30000
# Batas ukuran diff per panggilan LLM; file dikelompokkan per chunk
MAX_CHUNK_CHARS=60000
# File dengan diff lebih besar dari ini dilewati total (0 = tidak pernah)
SKIP_FILE_OVER_CHARS=100000
# Bahasa komentar review: id | en
REVIEW_LANGUAGE=id
# Severity minimum yang dikomentari: critical | high | medium | low | info
MIN_SEVERITY=low
# Maksimum komentar inline per review; sisanya masuk ringkasan
MAX_INLINE_COMMENTS=30

# ===== Infra =====
STATE_DB_PATH=data/review_state.db
LOG_LEVEL=INFO
